{
  "name": "release-autopilot",
  "version": "1.4.0",
  "description": "Semantic releases with notes written for the people who use the project.",
  "keywords": [
    "release",
    "semantic-release",
    "changelog",
    "release-notes",
    "conventional-commits",
    "github-actions",
    "claude",
    "cli"
  ],
  "license": "MIT",
  "author": "Rodrigo Roque <rodrigogoncalvesroque@gmail.com>",
  "homepage": "https://github.com/roquerodrigo/release-autopilot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roquerodrigo/release-autopilot.git"
  },
  "bugs": {
    "url": "https://github.com/roquerodrigo/release-autopilot/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "types": "./lib/index.d.ts",
  "bin": {
    "release-autopilot": "lib/bin.js"
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --minify --platform=node --target=node24 --format=cjs --loader:.md=text --legal-comments=linked --outfile=dist/index.cjs",
    "build:package": "rm -rf lib && esbuild src/index.ts src/bin.ts --bundle --platform=node --target=node24 --format=esm --packages=external --loader:.md=text --outdir=lib && tsc -p tsconfig.package.json",
    "lint": "eslint --fix",
    "prepack": "npm run build:package",
    "test": "tsc --noEmit && node --import ./tests/register-markdown.ts --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/main.ts' --test-coverage-exclude='src/bin.ts' --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 tests/*.test.ts"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@anthropic-ai/sdk": "^1.4.0",
    "@octokit/rest": "^22.0.1",
    "release-please": "17.11.2",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "globals": "17.14.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1"
  }
}
