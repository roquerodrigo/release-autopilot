{
  "name": "release-autopilot",
  "version": "1.1.2",
  "private": true,
  "description": "Semantic releases with notes written for the people who use the project.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --minify --platform=node --target=node24 --format=cjs --loader:.md=text --legal-comments=linked --outfile=dist/index.cjs",
    "lint": "eslint --fix",
    "test": "tsc --noEmit && node --import ./tests/register-markdown.ts --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/main.ts' --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 tests/*.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@anthropic-ai/sdk": "^1.4.0",
    "@octokit/rest": "^22.0.1",
    "release-please": "17.11.2",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "eslint-plugin-perfectionist": "5.10.1",
    "globals": "17.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
